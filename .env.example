# ==============================================================================
# Portfolio Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these in your Vercel Project Settings for production deployment.
# ==============================================================================

# Supabase PostgreSQL Database & Realtime
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Resend Email Delivery
# Found in: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Admin Dashboard Access Key
# Protects /admin and /api/admin/messages
ADMIN_SECRET_KEY=your-secure-admin-passcode-here

# Optional: GitHub API Token (for live /api/github/stats rate-limit expansion)
GITHUB_TOKEN=
